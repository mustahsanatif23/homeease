// HomeEase — Prisma schema
// Default provider is SQLite so the project runs with zero external setup.
// To use PostgreSQL: change `provider` below to "postgresql" and set DATABASE_URL.
// The schema is intentionally portable: no enums / Json / arrays are used, so the
// exact same models work on SQLite and PostgreSQL. Enum values are validated in
// TypeScript (lib/constants.ts) and by Zod at every entry point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?
  passwordHash    String
  role            String    @default("CUSTOMER") // CUSTOMER | PROVIDER | ADMIN
  accountStatus   String    @default("ACTIVE")   // ACTIVE | PENDING | SUSPENDED | DEACTIVATED
  avatar          String?
  address         String?
  area            String?
  latitude        Float?
  longitude       Float?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  customerProfile   CustomerProfile?
  providerProfile   ProviderProfile?
  sessions          Session[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  resetTokens       PasswordResetToken[]
  customerRequests  ServiceRequest[]     @relation("CustomerRequests")
  customerBookings  Booking[]            @relation("CustomerBookings")
  reviewsWritten    Review[]             @relation("ReviewAuthor")
  favorites         FavoriteProvider[]   @relation("CustomerFavorites")
  savedAddresses    SavedAddress[]
  messagesSent      Message[]            @relation("SentMessages")

  @@index([role, accountStatus])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  totalSpent   Int      @default(0) // whole BDT
  totalJobs    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  businessName       String
  bio                String?
  experienceYears    Int      @default(1)
  serviceRadiusKm    Float    @default(12)
  verificationStatus String   @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED
  verifiedAt         DateTime?
  rejectionReason    String?
  rating             Float    @default(0)
  ratingCount        Int      @default(0)
  completedJobs      Int      @default(0)
  cancelledJobs      Int      @default(0)
  acceptedCount      Int      @default(0)
  offeredCount       Int      @default(0)
  totalEarnings      Int      @default(0)
  autoAccept         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        ProviderService[]
  availability    ProviderAvailability[]
  timeOff         ProviderTimeOff[]
  requests        ServiceRequest[]      @relation("ProviderRequests")
  matches         RequestProviderMatch[]
  bookings        Booking[]             @relation("ProviderBookings")
  reviews         Review[]              @relation("ProviderReviews")
  favouritedBy    FavoriteProvider[]    @relation("ProviderFavorites")

  @@index([verificationStatus])
  @@index([rating])
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String
  icon        String
  image       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]
}

model Service {
  id                String   @id @default(cuid())
  categoryId        String
  name              String
  slug              String   @unique
  description       String
  basePrice         Int // whole BDT
  estimatedDuration Int // minutes
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category  ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  providers ProviderService[]
  requests  ServiceRequest[]

  @@index([categoryId, active])
}

model ProviderService {
  id              String   @id @default(cuid())
  providerId      String
  serviceId       String
  price           Int
  experienceYears Int      @default(1)
  expertiseLevel  String   @default("INTERMEDIATE") // BEGINNER | INTERMEDIATE | ADVANCED | EXPERT
  createdAt       DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
  @@index([serviceId])
}

model ProviderAvailability {
  id          String  @id @default(cuid())
  providerId  String
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startTime   String // "09:00"
  endTime     String // "18:00"
  isAvailable Boolean @default(true)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek])
}

model ProviderTimeOff {
  id         String   @id @default(cuid())
  providerId String
  date       DateTime
  startTime  String   @default("00:00")
  endTime    String   @default("23:59")
  reason     String?
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, date])
}

model SavedAddress {
  id         String  @id @default(cuid())
  customerId String
  label      String
  address    String
  area       String
  latitude   Float
  longitude  Float
  isDefault  Boolean @default(false)

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model FavoriteProvider {
  id         String   @id @default(cuid())
  customerId String
  providerId String
  createdAt  DateTime @default(now())

  customer User            @relation("CustomerFavorites", fields: [customerId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation("ProviderFavorites", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([customerId, providerId])
}

model ServiceRequest {
  id                 String   @id @default(cuid())
  customerId         String
  serviceId          String
  providerId         String?
  title              String
  description        String
  address            String
  area               String
  latitude           Float
  longitude          Float
  preferredDate      DateTime
  preferredStartTime String
  preferredEndTime   String
  urgency            String   @default("NORMAL") // NORMAL | HIGH | URGENT
  imageUrl           String?
  contactPhone       String
  estimatedPrice     Int      @default(0)
  finalPrice         Int?
  matchScore         Float?
  autoAssign         Boolean  @default(false)
  status             String   @default("PENDING") // PENDING | MATCHED | ASSIGNED | BOOKED | COMPLETED | CANCELLED | NO_PROVIDER
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer      User                   @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  service       Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  provider      ProviderProfile?       @relation("ProviderRequests", fields: [providerId], references: [id], onDelete: SetNull)
  matches       RequestProviderMatch[]
  bookings      Booking[]
  notifications Notification[]

  @@index([customerId, status])
  @@index([status, urgency])
  @@index([createdAt])
}

model RequestProviderMatch {
  id                    String   @id @default(cuid())
  requestId             String
  providerId            String
  rank                  Int      @default(0)
  matchScore            Float
  distanceKm            Float
  distanceScore         Float
  availabilityScore     Float
  ratingScore           Float
  priceScore            Float
  expertiseScore        Float
  workloadScore         Float
  estimatedPrice        Int
  estimatedArrivalMinutes Int
  reason                String // JSON array of strings
  declined              Boolean  @default(false)
  createdAt             DateTime @default(now())

  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([requestId, providerId])
  @@index([requestId, rank])
}

/// Chat thread between the customer and the provider for one booking.
model Message {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([senderId])
  @@index([bookingId, readAt])
}

model Booking {
  id            String   @id @default(cuid())
  requestId     String
  providerId    String
  customerId    String
  scheduledDate DateTime
  startTime     String
  endTime       String
  status        String   @default("REQUESTED") // REQUESTED | ACCEPTED | ON_THE_WAY | IN_PROGRESS | COMPLETED | CANCELLED | REJECTED | RESCHEDULED
  price         Int      @default(0)
  notes         String?
  acceptedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  request       ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider      ProviderProfile @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Restrict)
  customer      User            @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  invoice       Invoice?
  review        Review?
  messages      Message[]
  notifications Notification[]

  // Hard guarantee against double booking of the same slot.
  @@unique([providerId, scheduledDate, startTime], name: "provider_slot_unique")
  @@index([providerId, status])
  @@index([customerId, status])
  @@index([scheduledDate])
}

model Invoice {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  invoiceNumber String    @unique
  subtotal      Int
  serviceFee    Int
  urgencyFee    Int
  distanceFee   Int
  discount      Int       @default(0)
  total         Int
  paymentStatus String    @default("UNPAID") // UNPAID | PAID | REFUNDED
  issuedAt      DateTime  @default(now())
  paidAt        DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([paymentStatus])
}

model Review {
  id                    String   @id @default(cuid())
  bookingId             String   @unique
  customerId            String
  providerId            String
  rating                Int
  qualityRating         Int?
  professionalismRating Int?
  punctualityRating     Int?
  valueRating           Int?
  comment               String?
  createdAt             DateTime @default(now())

  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User            @relation("ReviewAuthor", fields: [customerId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation("ProviderReviews", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
}

model Notification {
  id               String   @id @default(cuid())
  userId           String
  type             String
  title            String
  message          String
  read             Boolean  @default(false)
  relatedRequestId String?
  relatedBookingId String?
  createdAt        DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  request ServiceRequest? @relation(fields: [relatedRequestId], references: [id], onDelete: Cascade)
  booking Booking?        @relation(fields: [relatedBookingId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String? // JSON string
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, createdAt])
  @@index([userId, createdAt])
}

model MatchingConfiguration {
  id                          String   @id @default("default")
  availabilityWeight          Float    @default(30)
  distanceWeight              Float    @default(20)
  ratingWeight                Float    @default(20)
  priceWeight                 Float    @default(15)
  expertiseWeight             Float    @default(10)
  workloadWeight              Float    @default(5)
  urgencyDistanceMultiplier   Float    @default(1.5)
  urgencyAvailabilityMultiplier Float  @default(1.4)
  serviceFeePercent           Float    @default(10)
  urgencyFeePercent           Float    @default(20)
  distanceFeePerKm            Int      @default(20)
  updatedAt                   DateTime @updatedAt
}
