{
  "name": "homeease",
  "version": "1.0.0",
  "private": true,
  "description": "HomeEase \u2014 Smart Home Service Automation Platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "node scripts/reset-db.mjs && prisma db push && node prisma/seed.mjs",
    "setup": "prisma generate && prisma db push && node prisma/seed.mjs",
    "postinstall": "prisma generate",
    "db:postgres": "node scripts/use-db.mjs postgresql",
    "db:sqlite": "node scripts/use-db.mjs sqlite",
    "vercel-build": "prisma generate && prisma db push --accept-data-loss && next build"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.5.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
