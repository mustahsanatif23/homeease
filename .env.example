# ---- Optional integrations (app runs fully without them) ------------------
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
MAPS_API_KEY=""
EMAIL_API_KEY=""
