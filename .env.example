# ---- Database -------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"
# PostgreSQL (see DATABASE.md to switch the Prisma provider):
# DATABASE_URL="postgresql://user:password@localhost:5432/homeease?schema=public"

# ---- Auth -----------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string"
